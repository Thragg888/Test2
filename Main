-- viltrumite hub — Obsidian UI
-- esp / stam / autoblock / hdt / aim / stab / misc

repeat task.wait() until game:IsLoaded()

-- =========================================================
-- Load Obsidian
-- =========================================================
local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library       = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager  = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager   = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Options = Library.Options
local Toggles = Library.Toggles

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local TextChatService   = game:GetService("TextChatService")
local Lighting          = game:GetService("Lighting")
local Workspace         = game:GetService("Workspace")
local Stats             = game:GetService("Stats")
local UIS               = game:GetService("UserInputService")

local lp = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if Workspace.CurrentCamera then Camera = Workspace.CurrentCamera end
end)

-- =========================================================
-- Network
-- =========================================================
local RemoteEvent
do
    local mods = ReplicatedStorage:WaitForChild("Modules", 10)
    local net1 = mods and mods:WaitForChild("Network", 10)
    local net2 = net1 and net1:WaitForChild("Network", 10)
    RemoteEvent = net2 and net2:WaitForChild("RemoteEvent", 10)
    if not RemoteEvent then warn("[viltrumite] RemoteEvent not found") end
end

local PlayersFolder   = workspace:WaitForChild("Players", 8)
local KillersFolder   = PlayersFolder and PlayersFolder:WaitForChild("Killers", 8)
local SurvivorsFolder = PlayersFolder and PlayersFolder:WaitForChild("Survivors", 8)

local function buildBuffer(str)
    local bytes = { 3, #str, 0, 0, 0 }
    for i = 1, #str do bytes[#bytes+1] = string.byte(str, i) end
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i-1, bytes[i]) end
    return b
end
local BLOCK_BUF = buildBuffer("Block")
local PUNCH_BUF = buildBuffer("Punch")

local HDT, AIM, AbilityHook, AUTOGEN, STAB, AZ, HBE, FacingVisual

local CFG = {
    AutoBlockEnabled = false,
    BlockCooldown    = 27,     -- <-- your 27s request
    BlockDelay       = 0,
    WallCheck        = true,
    SoundTrigger     = true,
    AnimTrigger      = true,
    PunchAfterBlock  = true,
    PunchDelay       = 0.12,
    AutoAimOnPunch   = true,
    AutoAimPunchDur  = 0.6,
    ESPKillers       = false,
    ESPSurvivors     = false,
    ESPGenerators    = false,
    ESPItems         = false,
    InfiniteStamina  = false,
}

-- =========================================================
-- Helpers
-- =========================================================
local function getMyRole()
    local c = lp.Character
    local p = c and c.Parent
    if p and (p.Name == "Survivors" or p.Name == "Killers") then return p.Name end
    return nil
end
local function getMyRoot()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end
local function getRoot(m)
    return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) or nil
end

local lastBlockFire  = 0
local lastPunchFire  = 0
local PUNCH_COOLDOWN = 0.08

local function firePunch()
    if not RemoteEvent then return end
    local now = tick()
    if now - lastPunchFire < PUNCH_COOLDOWN then return end
    lastPunchFire = now
    if CFG.AutoAimOnPunch and AIM and AIM.AimFor then
        pcall(function() AIM.AimFor(CFG.AutoAimPunchDur, "Punch") end)
    end
    pcall(function() RemoteEvent:FireServer("UseActorAbility", { PUNCH_BUF }) end)
end

local function fireBlock()
    if not RemoteEvent then return end
    local now = tick()
    if now - lastBlockFire < (CFG.BlockCooldown or 0.05) then return end
    lastBlockFire = now
    pcall(function() RemoteEvent:FireServer("UseActorAbility", { BLOCK_BUF }) end)

    if HDT and HDT.Enabled and HDT.AutoTrigger then
        pcall(function() HDT.TriggerFromAutoBlock() end)
    end

    if CFG.PunchAfterBlock then
        task.delay(CFG.PunchDelay, function()
            if HDT and HDT._dragging then
                local waited = 0
                while HDT._dragging and waited < 1.0 do
                    task.wait(0.05); waited += 0.05
                end
            end
            pcall(firePunch)
        end)
    end
end

-- =========================================================
-- REAL detection box (Part in workspace, like Cursedsaken)
-- =========================================================
FacingVisual = {
    VisualEnabled = false,       -- draw outline on the box
    BoxWidth      = 12,
    BoxHeight     = 8,
    BoxLength     = 30,
    BoxColor      = Color3.fromRGB(255, 60, 60),
    boxes         = {},          -- [killerModel] = { part, highlight }
    _conns        = {},
}

local OVERLAP = OverlapParams.new()
OVERLAP.FilterType = Enum.RaycastFilterType.Include
local function refreshOverlapFilter()
    OVERLAP.FilterDescendantsInstances = lp.Character and { lp.Character } or {}
end
lp.CharacterAdded:Connect(function() task.wait(0.1); refreshOverlapFilter() end)
refreshOverlapFilter()

local function destroyBox(killer)
    local data = FacingVisual.boxes[killer]
    if not data then return end
    if data.part and data.part.Parent then pcall(function() data.part:Destroy() end) end
    if data.conn then pcall(function() data.conn:Disconnect() end) end
    FacingVisual.boxes[killer] = nil
end

local function createBox(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyBox(killer)

    local part = Instance.new("Part")
    part.Name         = "ViltrumiteDetectionBox"
    part.Anchored     = true
    part.CanCollide   = false
    part.CanQuery     = false
    part.CanTouch     = false
    part.Massless     = true
    part.CastShadow   = false
    part.Transparency = 1                    -- invisible — size still used for GetPartsInPart
    part.Material     = Enum.Material.ForceField
    part.Size         = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
    part.Parent       = killer

    local hl = Instance.new("Highlight")
    hl.Name                = "ViltrumiteDetectionHighlight"
    hl.FillTransparency    = 1                -- only the outline
    hl.OutlineColor        = FacingVisual.BoxColor
    hl.OutlineTransparency = FacingVisual.VisualEnabled and 0 or 1
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = part

    local data = { part = part, highlight = hl, conn = nil }
    FacingVisual.boxes[killer] = data

    data.conn = RunService.Heartbeat:Connect(function()
        if not killer.Parent or not part.Parent then destroyBox(killer); return end
        local hrp = killer:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 1e-4 then return end
        flat = flat.Unit
        part.Size  = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
        part.CFrame = CFrame.lookAt(
            hrp.Position + flat * (FacingVisual.BoxLength * 0.5),
            hrp.Position + flat * (FacingVisual.BoxLength * 0.5 + 1)
        )
    end)
end

local function refreshVisualToggle()
    for _, data in pairs(FacingVisual.boxes) do
        if data.highlight and data.highlight.Parent then
            data.highlight.OutlineTransparency = FacingVisual.VisualEnabled and 0 or 1
        end
    end
end

local function ensureBoxes()
    if not KillersFolder then return end
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and not FacingVisual.boxes[k] then
            createBox(k)
        end
    end
end

if KillersFolder then
    KillersFolder.ChildAdded:Connect(function(k)
        if k:IsA("Model") then createBox(k) end
    end)
    KillersFolder.ChildRemoved:Connect(destroyBox)
    task.spawn(function()
        while true do
            task.wait(0.5)
            ensureBoxes()
        end
    end)
end

-- Block now uses a REAL overlap check against the box Part
local function isClientInRealBox(killerRoot)
    if not killerRoot then return false end
    local killer = killerRoot:FindFirstAncestorOfClass("Model")
    local data = killer and FacingVisual.boxes[killer]
    if not data or not data.part or not data.part.Parent then return false end
    if not lp.Character then return false end
    refreshOverlapFilter()
    local hits = workspace:GetPartsInPart(data.part, OVERLAP)
    return #hits > 0
end

-- =========================================================
-- LOS + sound/anim triggers
-- =========================================================
local RAY_LOS = RaycastParams.new()
RAY_LOS.FilterType = Enum.RaycastFilterType.Exclude
RAY_LOS.IgnoreWater = true
local function hasLOS(killerRoot)
    if not CFG.WallCheck then return true end
    if not killerRoot then return true end
    local myRoot = getMyRoot()
    if not myRoot then return true end
    local delta = killerRoot.Position - myRoot.Position
    if delta.Magnitude < 0.001 then return true end
    RAY_LOS.FilterDescendantsInstances = { lp.Character, killerRoot:FindFirstAncestorOfClass("Model") }
    return workspace:Raycast(myRoot.Position, delta, RAY_LOS) == nil
end

local function shouldBlock(killerRoot)
    if not killerRoot or not killerRoot.Parent then return false end
    if not isClientInRealBox(killerRoot) then return false end
    if not hasLOS(killerRoot) then return false end
    return true
end

local function nearestKillerPart()
    local myRoot = getMyRoot()
    if not myRoot or not KillersFolder then return nil end
    local best, bestDist = nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestDist = hrp, d end
            end
        end
    end
    return best
end

