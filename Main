    G:Toggle({ Title = "auto generator", Value = false, Callback = function(v) AUTOGEN.Enabled = v end })
    G:Slider({ Title = "gen range",    Value = { Min = 5, Max = 30, Default = AUTOGEN.MaxDistance }, Callback = function(v) AUTOGEN.MaxDistance = v end })
    G:Slider({ Title = "gen interval", Value = { Min = 0.3, Max = 5, Default = AUTOGEN.Cooldown }, Callback = function(v) AUTOGEN.Cooldown = v end })

    local H = Tab:Section({ Title = "hitbox expander" })
    H:Toggle({ Title = "enabled", Value = false, Callback = function(v)
        pcall(function() if v then hbeStart() else hbeStop() end end)
    end })
    H:Dropdown({ Title = "mode", Values = {"Scale", "Velocity"}, Value = "Scale", Callback = function(opt)
        pcall(function()
            HBE.Mode = opt or "Scale"
            if HBE.Enabled then hbeStop() hbeStart() end
        end)
    end })
    H:Slider({ Title = "size multiplier", Value = { Min = 1, Max = 5, Default = HBE.SizeMultiplier }, Callback = function(v)
        HBE.SizeMultiplier = v
        if HBE.Enabled then pcall(hbeApply) end
    end })
    H:Toggle({ Title = "only on attack", Value = false, Callback = function(v)
        pcall(function()
            HBE.ApplyOnlyOnAttack = v
            if HBE.Enabled and lp.Character then hbeDisconnectAll() hbeHookCharacter(lp.Character) end
        end)
    end })
    H:Toggle({ Title = "visualize", Value = false, Callback = function(v)
        HBE.Visualize = v
        pcall(hbeApplyVisual)
    end })
    H:Slider({ Title = "drag cooldown", Value = { Min = 0, Max = 5, Default = HBE.DragCooldown }, Callback = function(v) HBE.DragCooldown = v end })

    local M = Tab:Section({ Title = "utility" })
    M:Button({ Title = "fullbright", Callback = function()
        pcall(function()
            Lighting.Ambient = Color3.new(1,1,1)
            Lighting.OutdoorAmbient = Color3.new(1,1,1)
            Lighting.Brightness = 2; Lighting.ClockTime = 12
            local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
            if atmo then atmo:Destroy() end
        end)
    end })
    M:Button({ Title = "show chat", Callback = function()
        pcall(function()
            local cfg = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
            local inp = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
            if cfg then cfg.Enabled = true end
            if inp then inp.Enabled = true end
        end)
    end })
    M:Button({ Title = "reset character", Callback = function()
        pcall(function()
            local char = lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        end)
    end })
    M:Button({ Title = "anti lag", Callback = function()
        task.spawn(function()
            pcall(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/zxcursedsocute/Forsaken-Script/refs/heads/main/anti%20lag%20test"))()
            end)
        end)
    end })
end)

buildTab("theme", "palette", function(Tab)
    local S = Tab:Section({ Title = "theme" })
    S:Button({ Title = "Viltrumite (default)", Callback = function() pcall(function() WindUI:SetTheme("Viltrumite") end) end })
    S:Button({ Title = "Dark",                 Callback = function() pcall(function() WindUI:SetTheme("Dark") end) end })
    S:Button({ Title = "Light",                Callback = function() pcall(function() WindUI:SetTheme("Light") end) end })
end)

notify("viltrumite hub", "loaded")
