-- viltrumite hub
-- esp / stam / autoblock / hdt / aim / stab / misc
-- GUI: WindUI (white "Viltrumite" theme, theme changer via theme tab)

repeat task.wait() until game:IsLoaded()

-- =========================================================
-- Load WindUI  (same loader as hunter — proven working)
-- =========================================================
local WindUI
do
    local ok, res = pcall(function()
        return loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
    end)
    if not (ok and type(res) == "table" and res.CreateWindow) then
        warn("[viltrumite] WindUI failed to load:", res)
        return
    end
    WindUI = res
end

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local TextChatService   = game:GetService("TextChatService")
local Lighting          = game:GetService("Lighting")
local Workspace         = game:GetService("Workspace")
local Stats             = game:GetService("Stats")
local UIS               = game:GetService("UserInputService")

local lp = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if Workspace.CurrentCamera then Camera = Workspace.CurrentCamera end
end)

local Network, RemoteEvent
do
    local mods  = ReplicatedStorage:WaitForChild("Modules", 10)
    local net1  = mods  and mods:WaitForChild("Network", 10)
    local net2  = net1  and net1:WaitForChild("Network", 10)
    Network     = net2
    RemoteEvent = net2  and net2:WaitForChild("RemoteEvent", 10)
    if not RemoteEvent then
        warn("[viltrumite] Network.RemoteEvent not found - block/punch disabled")
    end
end

local PlayersFolder   = workspace:WaitForChild("Players", 8)
local KillersFolder   = PlayersFolder and PlayersFolder:WaitForChild("Killers", 8)
local SurvivorsFolder = PlayersFolder and PlayersFolder:WaitForChild("Survivors", 8)

local function buildBuffer(str)
    local bytes = { 3, #str, 0, 0, 0 }
    for i = 1, #str do bytes[#bytes + 1] = string.byte(str, i) end
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i - 1, bytes[i]) end
    return b
end

local BLOCK_BUF = buildBuffer("Block")
local PUNCH_BUF = buildBuffer("Punch")

local lastBlockFire = 0
local BLOCK_COOLDOWN = 0.05
local lastPunchFire = 0
local PUNCH_COOLDOWN = 0.08

local HDT, AIM, AbilityHook, AUTOGEN, STAB, AZ, HBE, FacingVisual

local CFG = {
    AutoBlockEnabled     = false,
    BlockDelay           = 0,
    WallCheck            = true,
    SoundTrigger         = true,
    AnimTrigger          = true,
    PunchAfterBlock      = true,
    PunchDelay           = 0.12,
    AutoAimOnPunch       = true,
    AutoAimPunchDuration = 0.6,
    ESPKillers           = false,
    ESPSurvivors         = false,
    ESPGenerators        = false,
    ESPItems             = false,
    InfiniteStamina      = false,
}

local function getMyRole()
    local c = lp.Character
    local p = c and c.Parent
    if p and (p.Name == "Survivors" or p.Name == "Killers") then return p.Name end
    return nil
end

local function getMyRoot()
    local char = lp.Character
    return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function getRoot(m)
    return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) or nil
end

local function firePunch()
    if not RemoteEvent then return false end
    local now = tick()
    if now - lastPunchFire < PUNCH_COOLDOWN then return false end
    lastPunchFire = now

    if CFG.AutoAimOnPunch and AIM and AIM.AimFor then
        pcall(function()
            AIM.AimFor(CFG.AutoAimPunchDuration or 0.6, "Punch")
        end)
    end

    pcall(function() RemoteEvent:FireServer("UseActorAbility", { PUNCH_BUF }) end)
    return true
end

local function fireBlock()
    if not RemoteEvent then return false end
    local now = tick()
    if now - lastBlockFire < BLOCK_COOLDOWN then return false end
    lastBlockFire = now
    pcall(function() RemoteEvent:FireServer("UseActorAbility", { BLOCK_BUF }) end)

    if FacingVisual then
        FacingVisual._blockPulse = (FacingVisual._blockPulse or 0) + 1
    end

    local hdtDidStart = false
    if HDT and HDT.Enabled and HDT.AutoTrigger then
        pcall(function() HDT.TriggerFromAutoBlock() end)
        if HDT._dragging then hdtDidStart = true end
    end

    if CFG.PunchAfterBlock then
        task.delay(CFG.PunchDelay or 0.12, function()
            if hdtDidStart then
                local waited = 0
                while HDT._dragging and waited < 1.0 do
                    task.wait(0.05)
                    waited += 0.05
                end
            end
            pcall(firePunch)
        end)
    end

    return true
end

local RAY_LOS = RaycastParams.new()
RAY_LOS.FilterType = Enum.RaycastFilterType.Exclude
RAY_LOS.IgnoreWater = true

local function hasLOS(killerRoot)
    if not CFG.WallCheck then return true end
    if not killerRoot then return true end
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return true end
    local delta = killerRoot.Position - myRoot.Position
    if delta.Magnitude < 0.001 then return true end
    RAY_LOS.FilterDescendantsInstances = { lp.Character, killerRoot:FindFirstAncestorOfClass("Model") }
    return workspace:Raycast(myRoot.Position, delta, RAY_LOS) == nil
end

local function isClientInKillerBox(killerRoot)
    if not killerRoot then return false end
    local myRoot = getMyRoot()
    if not myRoot then return false end

    local delta = myRoot.Position - killerRoot.Position
    local dist = delta.Magnitude
    if dist < 0.001 then return true end

    local look = killerRoot.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 1e-4 then return false end
    flatLook = flatLook.Unit
    local flatRight = Vector3.new(flatLook.Z, 0, -flatLook.X)

    local flatDelta = Vector3.new(delta.X, 0, delta.Z)
    local forwardDist = flatDelta:Dot(flatLook)
    local lateralDist = math.abs(flatDelta:Dot(flatRight))

    local length = (FacingVisual and FacingVisual.BoxLength) or 30
    local width  = (FacingVisual and FacingVisual.BoxWidth)  or 12

    if forwardDist < 0 then return false end
    if forwardDist > length then return false end
    if lateralDist > width * 0.5 then return false end
    return true
end

local function shouldBlock(killerRoot)
    if not killerRoot or not killerRoot.Parent then return false end
    if not isClientInKillerBox(killerRoot) then return false end
    if not hasLOS(killerRoot) then return false end
    return true
end

local function extractSoundId(sound)
    local sid = sound and sound.SoundId
    if not sid or sid == "" then return nil end
    return tostring(sid):match("(%d+)")
end

local function nearestKillerPart()
    local myRoot = getMyRoot()
    if not myRoot or not KillersFolder then return nil end
    local best, bestDist = nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestDist = hrp, d end
            end
        end
    end
    return best
end

