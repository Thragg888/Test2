-- UI Settings (SaveManager / ThemeManager handle their own groupboxes)
do
    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
    ThemeManager:SetFolder("Viltrumite")
    SaveManager:SetFolder("Viltrumite")
    SaveManager:BuildConfigSection(Tabs.UISet)
    ThemeManager:ApplyToTab(Tabs.UISet)

    local M = Tabs.UISet:AddLeftGroupbox("Menu")
    M:AddLabel("Menu key"):AddKeyPicker("MenuKeybind", {
        Default = "RightShift", NoUI = true, Text = "Menu keybind"
    })
    M:AddButton({ Text = "Unload", Func = function() Library:Unload() end })
    Library.ToggleKeybind = Options.MenuKeybind
end

