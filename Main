local TRIGGER_ANIMS_SET = {}
for _, id in ipairs(TRIGGER_ANIMS) do TRIGGER_ANIMS_SET[id] = true end

local lastAutoBlockByKiller = setmetatable({}, { __mode = "k" })
local AUTO_BLOCK_KILLER_DEBOUNCE = 0.12

local function tryAutoBlock(killerModel, killerRoot)
    if not CFG.AutoBlockEnabled then return end
    if not killerRoot or not killerRoot.Parent then return end
    if not shouldBlock(killerRoot) then return end
    local now = tick()
    local last = lastAutoBlockByKiller[killerModel]
    if last and now - last < AUTO_BLOCK_KILLER_DEBOUNCE then return end
    lastAutoBlockByKiller[killerModel] = now
    if CFG.BlockDelay > 0 then
        task.delay(CFG.BlockDelay, fireBlock)
    else
        fireBlock()
    end
end

local function extractSoundId(sound)
    local sid = sound and sound.SoundId
    if not sid or sid == "" then return nil end
    return tostring(sid):match("(%d+)")
end

local hookedSounds = {}
local lastSoundFire = setmetatable({}, { __mode = "k" })
local function onSoundTrigger(sound)
    local now = tick()
    local last = lastSoundFire[sound]
    if last and now - last < 0.1 then return end
    lastSoundFire[sound] = now
    local id = extractSoundId(sound)
    if not id or not TRIGGER_SOUNDS[id] then return end
    local ancestor = sound:FindFirstAncestorOfClass("Model")
    if not ancestor or ancestor.Parent ~= KillersFolder then return end
    if not CFG.SoundTrigger then return end
    tryAutoBlock(ancestor, ancestor:FindFirstChild("HumanoidRootPart"))
end
local function hookSound(sound)
    if hookedSounds[sound] then return end
    hookedSounds[sound] = true
    local c1 = sound.Played:Connect(function() onSoundTrigger(sound) end)
    local c2 = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying then onSoundTrigger(sound) end
    end)
    sound.Destroying:Once(function()
        hookedSounds[sound] = nil; lastSoundFire[sound] = nil
        pcall(function() c1:Disconnect() end)
        pcall(function() c2:Disconnect() end)
    end)
    if sound.IsPlaying then onSoundTrigger(sound) end
end
if KillersFolder then
    for _, d in ipairs(KillersFolder:GetDescendants()) do
        if d:IsA("Sound") then hookSound(d) end
    end
    KillersFolder.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then hookSound(d) end
    end)
end

local hookedAnims = {}
local function onAnimPlayed(killerModel, track)
    local animId = track.Animation and tostring(track.Animation.AnimationId):match("(%d+)")
    if not animId or not TRIGGER_ANIMS_SET[animId] then return end
    if not CFG.AnimTrigger then return end
    tryAutoBlock(killerModel, killerModel:FindFirstChild("HumanoidRootPart"))
end
local function hookKiller(killerModel)
    if not killerModel:IsA("Model") or hookedAnims[killerModel] then return end
    local function tryHook()
        if hookedAnims[killerModel] then return true end
        if not killerModel.Parent then return false end
        local hum = killerModel:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        hookedAnims[killerModel] = true
        local conn = animator.AnimationPlayed:Connect(function(track)
            onAnimPlayed(killerModel, track)
        end)
        killerModel.Destroying:Once(function()
            hookedAnims[killerModel] = nil
            pcall(function() conn:Disconnect() end)
        end)
        return true
    end
    if tryHook() then return end
    local conn1, conn2
    conn1 = killerModel.ChildAdded:Connect(function() if tryHook() then
        if conn1 then conn1:Disconnect() end
        if conn2 then conn2:Disconnect() end
    end end)
    conn2 = killerModel.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and tryHook() then
            if conn1 then conn1:Disconnect() end
            if conn2 then conn2:Disconnect() end
        end
    end)
end
if KillersFolder then
    for _, k in ipairs(KillersFolder:GetChildren()) do hookKiller(k) end
    KillersFolder.ChildAdded:Connect(hookKiller)
end

-- =========================================================
-- HDT / AIM / STAB / HBE / etc.  — unchanged logic
-- =========================================================
HDT = {
    Enabled = false, AutoTrigger = true, Speed = 12, StopDistance = 2,
    DragDuration = 0.4, Cooldown = 27, MaxRange = 40,
    _dragId = 0, _dragging = false, _conn = nil,
    _lastFire = 0, _fireDebounce = 0.15, _cooldownUntil = 0,
}
local function startDrag(targetPart)
    if not targetPart or not targetPart.Parent then return end
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if (targetPart.Position - hrp.Position).Magnitude <= HDT.StopDistance + 0.5 then return end
    HDT._dragId += 1
    local myId = HDT._dragId
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
    HDT._dragging = true
    local saved = { walk = hum.WalkSpeed, jump = hum.JumpPower, auto = hum.AutoRotate }
    hum.WalkSpeed = 0; hum.JumpPower = 0; hum.AutoRotate = false
    local finished = false
    local function cleanup()
        if finished then return end
        finished = true
        if HDT._dragId ~= myId then return end
        HDT._dragging = false
        HDT._cooldownUntil = tick() + (HDT.Cooldown or 27)
        if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if hum and hum.Parent then
            pcall(function()
                hum.WalkSpeed = saved.walk; hum.JumpPower = saved.jump; hum.AutoRotate = saved.auto
            end)
        end
    end
    HDT._conn = RunService.Heartbeat:Connect(function(dt)
        if HDT._dragId ~= myId or not HDT._dragging then cleanup(); return end
        if not (char and char.Parent and targetPart and targetPart.Parent) then cleanup(); return end
        local myPos = hrp.Position
        local flat = Vector3.new(targetPart.Position.X, myPos.Y, targetPart.Position.Z)
        local delta = flat - myPos
        local dist = delta.Magnitude
        if dist <= HDT.StopDistance then cleanup(); return end
        local step = math.min(HDT.Speed * dt, dist - HDT.StopDistance)
        hrp.CFrame = CFrame.lookAt(myPos + delta.Unit * step, flat)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    task.delay(HDT.DragDuration or 0.4, function()
        if HDT._dragId == myId and HDT._dragging then cleanup() end
    end)
end
function HDT.TriggerFromAutoBlock(force)
    if not force and not HDT.Enabled then return end
    if tick() < (HDT._cooldownUntil or 0) then return end
    if tick() - HDT._lastFire < HDT._fireDebounce then return end
    if HDT._dragging then return end
    local target = nearestKillerPart()
    if not target then return end
    local myRoot = getMyRoot()
    if myRoot then
        local d = (target.Position - myRoot.Position).Magnitude
        if d <= HDT.StopDistance + 0.5 then return end
        if d > HDT.MaxRange then return end
    end
    HDT._lastFire = tick()
    startDrag(target)
end
HDT.Trigger = function() HDT.TriggerFromAutoBlock(true) end
lp.CharacterAdded:Connect(function()
    HDT._dragId += 1; HDT._dragging = false; HDT._cooldownUntil = 0
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
end)

-- =========================================================
-- AIM
-- =========================================================
AIM = {
    Enabled = false, AimMode = "Camera", Smooth = 0.35,
    PredictMode = "Both", PredictLead = 0.15, PingMult = 1.0,
    Debug = false, CurrentAbility = nil, CachedTargetHRP = nil, _aimUntil = 0,
}
local PING_ABILITIES = { AimGun = true, GunFire = true, GunExplode = true, GunFail = true }
local function getPing()
    local ok, v = pcall(function() return lp:GetNetworkPing() end)
    if ok and type(v) == "number" then return v end
    ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()/1000 end)
    return ok and type(v) == "number" and v or 0
end
local function isPlayingSurvivor()
    if getMyRole() ~= "Survivors" then return false end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end
local function updateCachedTarget()
    local myRoot = getRoot(lp.Character)
    if not myRoot or not KillersFolder then AIM.CachedTargetHRP = nil return end
    local best, bestD = nil, 500
    for _, s in ipairs(KillersFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = hrp end
            end
        end
    end
    AIM.CachedTargetHRP = best
end
task.spawn(function()
    while true do task.wait(0.1); pcall(updateCachedTarget) end
end)
local function isPingAbility(n) return n and PING_ABILITIES[n] == true end
local function predictHRP(hrp)
    if not hrp then return nil end
    if AIM.PredictMode == "Off" then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.zero end
    local velLead, pingLead = 0, 0
    if AIM.PredictMode == "Velocity" or AIM.PredictMode == "Both" then velLead = AIM.PredictLead end
    if isPingAbility(AIM.CurrentAbility) and (AIM.PredictMode == "Ping" or AIM.PredictMode == "Both") then
        pingLead = math.clamp(getPing() * 0.5 * AIM.PingMult, 0, 0.5)
    end
    return hrp.Position + vel * math.clamp(velLead + pingLead, 0, 0.75)
end
function AIM.AimFor(duration, abilityName)
    AIM._aimUntil = tick() + (duration or 1.0)
    AIM.CurrentAbility = abilityName
end
local autoRotSaved = nil
local function restoreAutoRotate()
    if autoRotSaved == nil then return end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = autoRotSaved end
    autoRotSaved = nil
end
local function disableAutoRotate()
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if autoRotSaved == nil then autoRotSaved = hum.AutoRotate end
    hum.AutoRotate = false
end
lp.CharacterAdded:Connect(function() autoRotSaved = nil end)
local function ballisticAim(targetPos, projSpeed, gravity)
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetPos then return targetPos end
    local origin = myRoot.Position
    local delta = targetPos - origin
    local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude
    if horiz < 0.1 then return targetPos end
    local vert = delta.Y
    local v2 = projSpeed * projSpeed
    local g = gravity or workspace.Gravity
    local disc = v2 * v2 - g * (g * horiz * horiz + 2 * vert * v2)
    if disc < 0 then return targetPos end
    local angle = math.atan2(v2 - math.sqrt(disc), g * horiz)
    return origin + Vector3.new(delta.X, 0, delta.Z).Unit * horiz + Vector3.new(0, horiz * math.tan(angle), 0)
end

-- STUN ABILITY AUTO-AIM
local STUN_ABILITY_KEYS = {
    Punch = true, Slash = true, OneShot = true, AimGun = true,
    GunFire = true, CrystalPitch = true, Hatchet = true,
}
local ABILITY_LOCKS = {
    Punch=2.00, Slash=0.80, OneShot=1.20, AimGun=0.60,
    GunFire=1.20, CrystalPitch=1.40, Hatchet=0.95,
}
local DEFAULT_LOCK = 0.85
local ABILITY_AIM_PART = {
    Punch="Head", Slash="Head", OneShot="Head", AimGun="Head",
    GunFire="Head", CrystalPitch="Head", Hatchet="Head",
}
local BALLISTIC = { CrystalPitch = true }
local TRIGGER_WINDOW = 0.18
local STUN_ANIMS = {}
local STUN_BY_ABILITY = {}
local GUEST_PUNCH_ANIMS = {
    ["126830014841198"]="Punch", ["126355327951215"]="Punch", ["121086746534252"]="Punch",
}
local function registerGuestPunchAnims()
    local lock = ABILITY_LOCKS.Punch or DEFAULT_LOCK
    local aimPart = ABILITY_AIM_PART.Punch or "Head"
    for id in pairs(GUEST_PUNCH_ANIMS) do
        STUN_ANIMS[id] = { Ability="Punch", Lock=lock, AimPart=aimPart, Ballistic=false }
        AbilityHook._registered = (AbilityHook._registered or 0) + 1
    end
    STUN_BY_ABILITY.Punch = { AimPart=aimPart, Ballistic=false, Lock=lock }
end
AbilityHook = { Enabled = true, Cooldown = 1.0, LockMultiplier = 1.0,
    _lastFire = 0, _animConn = nil, _registered = 0, _lastName = "" }
local function extractAnimIds(v, out)
    out = out or {}
    if type(v) == "string" then
        local id = v:match("(%d+)"); if id then out[#out+1] = id end
    elseif type(v) == "number" then out[#out+1] = tostring(v)
    elseif type(v) == "table" then for _, x in pairs(v) do extractAnimIds(x, out) end end
    return out
end
local function getAnimsTable(cfg)
    if type(cfg) ~= "table" then return nil end
    if type(cfg.Animations) == "table" then return cfg.Animations end
    if type(cfg.Config) == "table" and type(cfg.Config.Animations) == "table" then return cfg.Config.Animations end
end
local function isStunAbility(n) return STUN_ABILITY_KEYS[n] == true end
local function registerAnimsFrom(anims)
    if not anims then return 0 end
    local count = 0
    for abilityName, animValue in pairs(anims) do
        if isStunAbility(abilityName) then
            local lock = ABILITY_LOCKS[abilityName] or DEFAULT_LOCK
            local aimPart = ABILITY_AIM_PART[abilityName] or "HumanoidRootPart"
            local ballistic = BALLISTIC[abilityName] or false
            for _, id in ipairs(extractAnimIds(animValue)) do
                STUN_ANIMS[id] = { Ability=abilityName, Lock=lock, AimPart=aimPart, Ballistic=ballistic }
                count = count + 1
            end
            STUN_BY_ABILITY[abilityName] = { AimPart=aimPart, Ballistic=ballistic, Lock=lock }
        end
    end
    return count
end
local function loadCharacterAnims()
    STUN_ANIMS = {}; STUN_BY_ABILITY = {}; AbilityHook._registered = 0
    local char = lp.Character
    if not char then return end
    local name = char:GetAttribute("CharacterName") or char.Name
    local skin = char:GetAttribute("SkinName") or ""
    if not name or name == "" then return end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    pcall(function()
        local cfg = require(assets.Survivors[name].Config)
        AbilityHook._registered += registerAnimsFrom(getAnimsTable(cfg))
    end)
    if skin ~= "" then
        pcall(function()
            local cfg = require(assets.Skins.Survivors[name][skin].Config)
            AbilityHook._registered += registerAnimsFrom(getAnimsTable(cfg))
        end)
    end
    pcall(function()
        local beh = require(assets.Survivors[name].Behavior)
        if type(beh) == "table" and type(beh.Abilities) == "table" then
            for abilityName, entry in pairs(beh.Abilities) do
                if isStunAbility(abilityName) and type(entry) == "table" then
                    for _, animId in ipairs(extractAnimIds(entry.AnimationId or entry.Animation)) do
                        STUN_ANIMS[animId] = {
                            Ability = abilityName,
                            Lock = ABILITY_LOCKS[abilityName] or DEFAULT_LOCK,
                            AimPart = ABILITY_AIM_PART[abilityName] or "HumanoidRootPart",
                            Ballistic = BALLISTIC[abilityName] or false,
                        }
                        AbilityHook._registered += 1
                    end
                end
            end
        end
    end)
    registerGuestPunchAnims()
end
local function bindAnimWatch()
    if AbilityHook._animConn then
        pcall(function() AbilityHook._animConn:Disconnect() end)
        AbilityHook._animConn = nil
    end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then task.delay(0.4, bindAnimWatch) return end
    AbilityHook._animConn = animator.AnimationPlayed:Connect(function(track)
        if not AbilityHook.Enabled then return end
        local anim = track and track.Animation
        if not anim then return end
        local id = tostring(anim.AnimationId):match("(%d+)")
        local info = id and STUN_ANIMS[id]
        if not info then return end
        if track.TimePosition > TRIGGER_WINDOW then return end
        local now = tick()
        if now - (AbilityHook._lastFire or 0) < (AbilityHook.Cooldown or 1.0) then return end
        AbilityHook._lastFire = now
        AIM.AimFor(info.Lock * (AbilityHook.LockMultiplier or 1.0), info.Ability)
    end)
end
lp.CharacterAdded:Connect(function()
    task.wait(0.4); loadCharacterAnims(); bindAnimWatch()
end)
task.spawn(function()
    if lp.Character then task.wait(0.4); loadCharacterAnims(); bindAnimWatch() end
end)
task.spawn(function()
    while true do
        task.wait(5)
        if lp.Character then
            local name = lp.Character:GetAttribute("CharacterName") or lp.Character.Name
            if AbilityHook._registered == 0 or name ~= AbilityHook._lastName then
                AbilityHook._lastName = name; loadCharacterAnims(); bindAnimWatch()
            end
        end
    end
end)

RunService:BindToRenderStep("ViltrumiteAim", Enum.RenderPriority.Camera.Value + 1, function()
    if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
    if not isPlayingSurvivor() then restoreAutoRotate(); return end
    local active = AIM.Enabled or (tick() < (AIM._aimUntil or 0))
    if not active or not AIM.CachedTargetHRP or not AIM.CachedTargetHRP.Parent then
        restoreAutoRotate(); return
    end
    local myRoot = getMyRoot()
    if not myRoot then restoreAutoRotate(); return end
    local targetPos = predictHRP(AIM.CachedTargetHRP)
    if not targetPos then return end
    if AIM.CurrentAbility and AIM.CachedTargetHRP.Parent then
        local killer = AIM.CachedTargetHRP.Parent
        local ov = STUN_BY_ABILITY[AIM.CurrentAbility]
        if ov then
            if ov.AimPart and ov.AimPart ~= "HumanoidRootPart" then
                local p = killer:FindFirstChild(ov.AimPart)
                if p and p:IsA("BasePart") then targetPos = p.Position end
            end
            if ov.Ballistic then targetPos = ballisticAim(targetPos, 80, workspace.Gravity) end
        end
    end
    local mode, smooth = AIM.AimMode, AIM.Smooth
    if mode == "Camera" or mode == "HRP+Camera" then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), smooth)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        disableAutoRotate()
        local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
        local delta = flat - myRoot.Position
        if delta.Magnitude > 0.05 then
            myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.lookAt(myRoot.Position, flat), smooth)
        end
    else restoreAutoRotate() end
end)

-- AUTOGEN, ESP refresh, stamina, STAB, AZ, HBE — kept the same logic as your original
-- (they don't depend on the UI library, so nothing changes)

AUTOGEN = { Enabled=false, Cooldown=1.0, MaxDistance=10, _nextFire=0 }
local function getIngameMap()
    local map = workspace:FindFirstChild("Map")
    map = map and map:FindFirstChild("Ingame")
    return map and map:FindFirstChild("Map")
end
task.spawn(function()
    while true do
        task.wait(0.1)
        if AUTOGEN.Enabled and tick() >= AUTOGEN._nextFire then
            local map = getIngameMap()
            local myRoot = getMyRoot()
            if map and myRoot then
                local any = false
                for _, obj in ipairs(map:GetChildren()) do
                    if (obj.Name == "Generator" or obj.Name == "FakeGenerator") and obj:IsA("Model") then
                        local prog, main = obj:FindFirstChild("Progress"), obj:FindFirstChild("Main")
                        if prog and main and prog.Value ~= 100
                           and (main.Position - myRoot.Position).Magnitude <= AUTOGEN.MaxDistance then
                            local remotes = obj:FindFirstChild("Remotes")
                            local re = remotes and remotes:FindFirstChild("RE")
                            if re then pcall(function() re:FireServer() end); any = true end
                        end
                    end
                end
                if any then AUTOGEN._nextFire = tick() + AUTOGEN.Cooldown end
            end
        end
    end
end)

local espTrackers = { Killers={}, Survivors={}, Generators={}, Items={} }
local function attachHighlight(model, fill, tracker, adornee)
    if not model or not model.Parent then return end
    local ex = tracker[model]
    if ex and ex.Parent then
        ex.Adornee = adornee or model; ex.FillColor = fill; ex.OutlineColor = fill
        return
    end
    if ex then tracker[model] = nil end
    local hl = Instance.new("Highlight")
    hl.Name = "ViltrumiteESP"; hl.Adornee = adornee or model
    hl.FillColor = fill; hl.OutlineColor = fill
    hl.FillTransparency = 0.6; hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model; tracker[model] = hl
end
local function detach(model, tracker)
    local hl = tracker[model]
    if hl then pcall(function() hl:Destroy() end); tracker[model] = nil end
end
local function refreshKillersESP()
    if not KillersFolder then return end
    local seen = {}
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character and k:FindFirstChild("HumanoidRootPart") then
            seen[k] = true
            local hl = espTrackers.Killers[k]
            if not hl or not hl.Parent then
                attachHighlight(k, Color3.fromRGB(255,40,40), espTrackers.Killers)
            end
        end
    end
    for m in pairs(espTrackers.Killers) do
        if not seen[m] or not m.Parent then detach(m, espTrackers.Killers) end
    end
end
local function refreshSurvivorsESP()
    if not SurvivorsFolder then return end
    local seen = {}
    for _, s in ipairs(SurvivorsFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character and s:FindFirstChild("HumanoidRootPart") then
            seen[s] = true
            local hl = espTrackers.Survivors[s]
            if not hl or not hl.Parent then
                attachHighlight(s, Color3.fromRGB(40,255,90), espTrackers.Survivors)
            end
        end
    end
    for m in pairs(espTrackers.Survivors) do
        if not seen[m] or not m.Parent then detach(m, espTrackers.Survivors) end
    end
end
local function refreshGeneratorsESP()
    local map = getIngameMap(); local seen = {}
    if map then
        for _, g in ipairs(map:GetChildren()) do
            if g.Name == "Generator" and g:IsA("Model") then
                seen[g] = true
                local prog = g:FindFirstChild("Progress")
                local c = (prog and prog.Value >= 100) and Color3.fromRGB(0,220,60) or Color3.fromRGB(255,220,40)
                attachHighlight(g, c, espTrackers.Generators)
            end
        end
    end
    for m in pairs(espTrackers.Generators) do
        if not seen[m] or not m.Parent then detach(m, espTrackers.Generators) end
    end
end
local ITEM_COLORS = { Medkit=Color3.fromRGB(255,105,180), BloxyCola=Color3.fromRGB(0,150,255) }
local lastItemScan = 0
local function refreshItemsESP()
    local now = tick()
    if now - lastItemScan < 1.0 then return end
    lastItemScan = now
    local ingame = workspace:FindFirstChild("Map")
    ingame = ingame and ingame:FindFirstChild("Ingame")
    local seen = {}
    if ingame then
        for _, item in ipairs(ingame:GetDescendants()) do
            local c = ITEM_COLORS[item.Name]
            if c and item:IsA("Tool") then
                local handle = item:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    seen[item] = true
                    attachHighlight(item, c, espTrackers.Items, handle)
                end
            end
        end
    end
    for m in pairs(espTrackers.Items) do
        if not seen[m] or not m.Parent then detach(m, espTrackers.Items) end
    end
end
local function clearESP(tracker) for m in pairs(tracker) do detach(m, tracker) end end
task.spawn(function()
    while true do
        task.wait(0.4)
        if CFG.ESPKillers then refreshKillersESP() end
        if CFG.ESPSurvivors then refreshSurvivorsESP() end
        if CFG.ESPGenerators then refreshGeneratorsESP() end
        if CFG.ESPItems then refreshItemsESP() end
    end
end)

-- STAM
local Sprinting = nil
pcall(function() Sprinting = require(ReplicatedStorage.Systems.Character.Game.Sprinting) end)
local staminaBackup, staminaThread = {}, nil
local function startInfStam()
    if not Sprinting or staminaThread then return end
    staminaBackup = { StaminaLossDisabled = Sprinting.StaminaLossDisabled }
    staminaThread = task.spawn(function()
        while CFG.InfiniteStamina do
            pcall(function()
                Sprinting.StaminaLossDisabled = true
                if Sprinting.Stamina ~= nil and Sprinting.MaxStamina then
                    Sprinting.Stamina = Sprinting.MaxStamina
                end
            end)
            task.wait(0.15)
        end
    end)
end
local function stopInfStam()
    if staminaThread then task.cancel(staminaThread); staminaThread = nil end
    if Sprinting and staminaBackup.StaminaLossDisabled ~= nil then
        pcall(function() Sprinting.StaminaLossDisabled = staminaBackup.StaminaLossDisabled end)
    end
end

-- STAB
STAB = { Enabled=false, BehindOffset=1.7, MaxRange=60, Cooldown=0.5,
    TeleportDelay=0.02, FollowDuration=0.5, _lastStab=0, _stabbing=false,
    _followConn=nil, _savedAutoRotate=true, _animConn=nil }
local DAGGER_ANIM_IDS = { ["100725497418533"]=true, ["89448354637442"]=true }
local function stabGetMyHRP() local c=lp.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function stabGetMyHum() local c=lp.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function stabGetKillerHRP(m)
    if not m then return nil end
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
end
local function stabGetNearestKiller()
    local myRoot = stabGetMyHRP()
    if not myRoot or not KillersFolder then return nil, nil end
    local best, bestHRP, bestDist = nil, nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character then
            local hrp = stabGetKillerHRP(k)
            local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestHRP, bestDist = k, hrp, d end
            end
        end
    end
    return best, bestHRP
end
local function stabStopFollow()
    if STAB._followConn then pcall(function() STAB._followConn:Disconnect() end); STAB._followConn = nil end
    local hum = stabGetMyHum(); if hum then hum.AutoRotate = STAB._savedAutoRotate end
    STAB._stabbing = false
end
local function stabFollow(killer)
    if STAB._followConn then pcall(function() STAB._followConn:Disconnect() end); STAB._followConn = nil end
    local hum = stabGetMyHum()
    STAB._savedAutoRotate = hum and hum.AutoRotate or true
    if hum then hum.AutoRotate = false end
    local endTime = tick() + STAB.FollowDuration
    STAB._followConn = RunService.RenderStepped:Connect(function()
        if tick() >= endTime or not STAB._stabbing then stabStopFollow(); return end
        local h = stabGetMyHRP(); if not h then stabStopFollow(); return end
        local kHRP = killer and stabGetKillerHRP(killer)
        if not kHRP or not kHRP.Parent then stabStopFollow(); return end
        local kCF = kHRP.CFrame
        local behind = kCF.Position - kCF.LookVector * STAB.BehindOffset
        h.CFrame = h.CFrame:Lerp(CFrame.lookAt(
            Vector3.new(behind.X, h.Position.Y, behind.Z),
            Vector3.new(kCF.Position.X, h.Position.Y, kCF.Position.Z)
        ), 0.5)
        h.AssemblyLinearVelocity = Vector3.zero
    end)
end
local function stabActivate(force)
    if not force and not STAB.Enabled then return end
    if STAB._stabbing then return end
    if tick() - STAB._lastStab < STAB.Cooldown then return end
    if getMyRole() ~= "Survivors" then return end
    local myHRP = stabGetMyHRP(); if not myHRP then return end
    local killer, kHRP = stabGetNearestKiller()
    if not killer or not kHRP then return end
    if (kHRP.Position - myHRP.Position).Magnitude > STAB.MaxRange then return end
    STAB._stabbing = true; STAB._lastStab = tick()
    task.spawn(function()
        local kCF = kHRP.CFrame
        local behind = kCF.Position - kCF.LookVector * STAB.BehindOffset
        task.wait(STAB.TeleportDelay)
        if not STAB.Enabled and not force then STAB._stabbing = false; return end
        if not kHRP or not kHRP.Parent then STAB._stabbing = false; return end
        local now = stabGetMyHRP(); if not now then STAB._stabbing = false; return end
        now.CFrame = CFrame.lookAt(
            Vector3.new(behind.X, now.Position.Y, behind.Z),
            Vector3.new(kCF.Position.X, now.Position.Y, kCF.Position.Z)
        )
        now.AssemblyLinearVelocity = Vector3.zero
        stabFollow(killer)
    end)
    task.delay((STAB.FollowDuration or 0.5) + 0.75, function()
        if STAB._stabbing and not STAB._followConn then STAB._stabbing = false end
    end)
end
_G.ViltrumiteStabActivate = stabActivate
local function stabBindAnimator()
    if STAB._animConn then pcall(function() STAB._animConn:Disconnect() end); STAB._animConn = nil end
    local char = lp.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    STAB._animConn = animator.AnimationPlayed:Connect(function(track)
        if not STAB.Enabled then return end
        local a = track and track.Animation
        local id = a and tostring(a.AnimationId):match("%d+")
        if id and DAGGER_ANIM_IDS[id] then task.spawn(stabActivate) end
    end)
end
stabBindAnimator()
lp.CharacterAdded:Connect(function() stabStopFollow(); task.wait(0.5); stabBindAnimator() end)

-- AZ QTE
AZ = { AutoQTE=false, InfiniteQTE=false, qteHooked=false }
local function azHookQTE()
    if AZ.qteHooked then return true end
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Assets.Killers.Azure.Config.cl_WorkaroundModules.cl_ConstructQTE)
    end)
    if not ok or type(mod) ~= "table" or type(mod.new) ~= "function" then return false end
    local origNew = mod.new
    AZ.qteHooked = pcall(function()
        mod.new = function(...)
            local qte = origNew(...)
            if qte then
                if AZ.InfiniteQTE then pcall(function() qte.FailedAttempts = -math.huge end) end
                if AZ.AutoQTE then
                    task.defer(function()
                        task.wait(0.12)
                        if AZ.AutoQTE and qte and type(qte.AddProgress) == "function" then
                            pcall(function() qte:AddProgress(100) end)
                        end
                    end)
                end
            end
            return qte
        end
    end)
    return AZ.qteHooked
end
task.spawn(function()
    while true do
        task.wait(1.0)
        if (AZ.AutoQTE or AZ.InfiniteQTE) and not AZ.qteHooked then pcall(azHookQTE) end
    end
end)

-- HBE
HBE = { Enabled=false, Mode="Scale", SizeMultiplier=1.5, ApplyOnlyOnAttack=false,
    Visualize=false, VelocitySpeed=55, VelocityStopDist=2, DragCooldown=1.0,
    _hitbox=nil, _origSize=nil, _sizeConn=nil, _charConns={}, _animConns={},
    _visuals={}, _attackOpen=false, _dragConn=nil, _dragBV=nil, _dragOrigin=nil,
    _dragHum=nil, _dragCooldownUntil=0 }
local HBE_HITBOX_NAMES = { "CollisionHitbox", "Hitbox", "MainHitbox", "MeleeHitbox" }
local function hbeFindHitbox(char)
    if not char then return nil end
    for _, name in ipairs(HBE_HITBOX_NAMES) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("hitbox", 1, true) then return d end
    end
end
local function hbeIsActive()
    if not HBE.Enabled then return false end
    if HBE.ApplyOnlyOnAttack then return HBE._attackOpen == true end
    return true
end
local function hbeDesiredSize()
    local p = HBE._hitbox
    if not p or not HBE._origSize then return nil end
    if not hbeIsActive() then return HBE._origSize end
    local m = HBE.SizeMultiplier
    return Vector3.new(HBE._origSize.X*m, HBE._origSize.Y*m, HBE._origSize.Z*m)
end
local function hbeApply()
    local p = HBE._hitbox
    if not p or not p.Parent then return end
    local t = hbeDesiredSize(); if not t then return end
    if (p.Size - t).Magnitude > 0.001 then p.Size = t end
end
local function hbeRevert()
    local p = HBE._hitbox
    if p and p.Parent and HBE._origSize then pcall(function() p.Size = HBE._origSize end) end
end
local function hbeStopDrag(natural)
    if HBE._dragConn then pcall(function() HBE._dragConn:Disconnect() end); HBE._dragConn = nil end
    if HBE._dragBV and HBE._dragBV.Parent then pcall(function() HBE._dragBV:Destroy() end) end
    HBE._dragBV = nil
    if HBE._dragHum and HBE._dragHum.Parent and HBE._dragOrigin then
        pcall(function()
            HBE._dragHum.WalkSpeed = HBE._dragOrigin.walk
            HBE._dragHum.JumpPower = HBE._dragOrigin.jump
            HBE._dragHum.AutoRotate = HBE._dragOrigin.autoRot
        end)
    end
    HBE._dragHum = nil; HBE._dragOrigin = nil
    if natural then HBE._dragCooldownUntil = tick() + (HBE.DragCooldown or 1.0) end
end
local function hbeStartDrag()
    if HBE.Mode ~= "Velocity" then return end
    if getMyRole() ~= "Survivors" then return end
    if HBE._dragConn or tick() < (HBE._dragCooldownUntil or 0) then return end
    local char = lp.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    HBE._dragHum = hum
    HBE._dragOrigin = { walk=hum.WalkSpeed, jump=hum.JumpPower, autoRot=hum.AutoRotate }
    hum.WalkSpeed = 0; hum.JumpPower = 0; hum.AutoRotate = false
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5); bv.Velocity = Vector3.zero
    bv.Parent = hrp; HBE._dragBV = bv
    HBE._dragConn = RunService.Heartbeat:Connect(function()
        if not hbeIsActive() or HBE.Mode ~= "Velocity" then hbeStopDrag(false); return end
        if not char.Parent or not hrp.Parent then hbeStopDrag(false); return end
        local k = nearestKillerPart()
        if not k or not k.Parent then bv.Velocity = Vector3.zero; return end
        local delta = k.Position - hrp.Position
        local horiz = Vector3.new(delta.X, 0, delta.Z)
        local dist = horiz.Magnitude
        if dist < HBE.VelocityStopDist then hbeStopDrag(true); return end
        local dir = horiz.Unit
        bv.Velocity = Vector3.new(dir.X * HBE.VelocitySpeed, 0, dir.Z * HBE.VelocitySpeed)
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(k.Position.X, hrp.Position.Y, k.Position.Z))
    end)
end
local function hbeDisconnectAll()
    if HBE._sizeConn then pcall(function() HBE._sizeConn:Disconnect() end); HBE._sizeConn = nil end
    for _, c in ipairs(HBE._charConns) do pcall(function() c:Disconnect() end) end
    HBE._charConns = {}
    for _, c in ipairs(HBE._animConns) do pcall(function() c:Disconnect() end) end
    HBE._animConns = {}
    hbeStopDrag(false)
end
local function hbeOnAttackOpen()
    if not HBE.Enabled or not HBE.ApplyOnlyOnAttack then return end
    HBE._attackOpen = true
    hbeApply()
    if HBE.Mode == "Velocity" then hbeStartDrag() end
end
local function hbeOnAttackClose()
    HBE._attackOpen = false
    if HBE.Mode == "Velocity" then hbeStopDrag(true) end
    if not HBE.Enabled then return end
    hbeApply()
end
local function hbeHookAnimator(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    local c = animator.AnimationPlayed:Connect(function(track)
        if not HBE.Enabled then return end
        local prio = track.Priority
        if prio ~= Enum.AnimationPriority.Action and prio ~= Enum.AnimationPriority.Action2
           and prio ~= Enum.AnimationPriority.Action3 and prio ~= Enum.AnimationPriority.Action4 then return end
        hbeOnAttackOpen()
        local dur = track.Length; if not dur or dur <= 0 then dur = 0.35 end
        task.delay(dur + 0.05, hbeOnAttackClose)
    end)
    table.insert(HBE._animConns, c)
end
local function hbeHookCharacter(char)
    if not char then return end
    hbeDisconnectAll(); hbeRevert()
    HBE._hitbox = nil; HBE._origSize = nil; HBE._attackOpen = false
    HBE._dragCooldownUntil = 0
    task.spawn(function()
        local hitbox, t0 = nil, tick()
        while tick() - t0 < 6 do
            hitbox = hbeFindHitbox(char)
            if hitbox then break end
            task.wait(0.1)
        end
        if not hitbox or not HBE.Enabled then return end
        HBE._hitbox = hitbox; HBE._origSize = hitbox.Size
        HBE._sizeConn = hitbox:GetPropertyChangedSignal("Size"):Connect(function()
            if not HBE.Enabled then return end
            local w = hbeDesiredSize()
            if w and (hitbox.Size - w).Magnitude > 0.01 then hitbox.Size = w end
        end)
        if HBE.ApplyOnlyOnAttack then hbeHookAnimator(char) end
        hbeApply()
    end)
end
local function hbeStart() HBE.Enabled = true; if lp.Character then hbeHookCharacter(lp.Character) end end
local function hbeStop() HBE.Enabled = false; HBE._attackOpen = false; hbeDisconnectAll(); hbeRevert() end
lp.CharacterAdded:Connect(function(char)
    hbeStopDrag(false)
    if HBE.Enabled then task.wait(0.5); hbeHookCharacter(char) end
end)

-- Input
if _G.ViltrumiteInputConn then
    pcall(function() _G.ViltrumiteInputConn:Disconnect() end)
    _G.ViltrumiteInputConn = nil
end
_G.ViltrumiteInputConn = UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        pcall(function() HDT.Trigger() end)
    elseif input.KeyCode == Enum.KeyCode.H then
        task.spawn(function() pcall(function() _G.ViltrumiteStabActivate(true) end) end)
    elseif input.KeyCode == Enum.KeyCode.C then
        AIM.AimFor(3.0)
    end
end)

